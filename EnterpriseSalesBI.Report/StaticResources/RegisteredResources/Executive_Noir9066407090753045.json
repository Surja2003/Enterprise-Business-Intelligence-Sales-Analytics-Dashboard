{
  "name": "Executive Noir",
  "dataColors": [
    "#D6AC58",
    "#58A6A6",
    "#65C99A",
    "#956BC4",
    "#E77D67",
    "#B8934A",
    "#3F7F7F",
    "#4B9C78",
    "#7552A0",
    "#C2604C"
  ],
  "foreground": "#F2F2F2",
  "foregroundNeutralSecondary": "#A5A5A5",
  "foregroundNeutralTertiary": "#6E6E6E",
  "background": "#080808",
  "backgroundLight": "#141414",
  "backgroundNeutral": "#262626",
  "tableAccent": "#D6AC58",
  "good": "#65C99A",
  "neutral": "#D6AC58",
  "bad": "#E77D67",
  "maximum": "#D6AC58",
  "center": "#58A6A6",
  "minimum": "#1F1F1F",
  "null": "#6E6E6E",
  "hyperlink": "#D6AC58",
  "visitedHyperlink": "#B8934A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#F2F2F2"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#F2F2F2"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#F2F2F2"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#A5A5A5"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#141414"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#262626"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#6E6E6E"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "gridlineShow": false,
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6E6E6E"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#080808"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#080808"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1F1F1F"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141414"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#141414"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#141414"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A5A5A5"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141414"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "backColor": {
              "solid": {
                "color": "#141414"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#141414"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#141414"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F2F2F2"
              }
            },
            "background": {
              "solid": {
                "color": "#141414"
              }
            },
            "textSize": 11
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#6E6E6E"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}