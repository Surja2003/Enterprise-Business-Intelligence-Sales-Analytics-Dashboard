                "textRuns": [
                  {
                    "value": "Sales definitions",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#D6AC58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Amazon recorded sales",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sum of Amount where Status is Shipped or Shipped - Delivered to Buyer. Source: Amazon Sale Report.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cancelled, returned, rejected, lost, damaged and pending orders stay in the table but are excluded from sales. Each has its own count.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "International recorded sales",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sum of the original GROSS AMT. PCS x RATE is kept separately, and the gap is shown as a discount rather than overwriting the source value.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Total recorded sales",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Amazon plus International. The two cover different periods and overlap only in April to May 2022, so a combined figure is not a like-for-like comparison.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Currency",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Amazon is recorded in INR. International has no currency field. It is shown in rupees because its rates sit in the same range as Amazon prices. This is an assumption, not a fact in the data.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#D6AC58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Metrics deliberately not shown",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#D6AC58"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Net profit, gross profit and COGS",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No product cost data exists. Expense IIGF is one event's cash sheet, not business costs. Sales minus expenses would be misleading.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Year-over-year growth",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No period exists in both years for the same segment, so YoY measures correctly return blank.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Stock turnover and remaining stock",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#F2F2F2"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Stock is a single undated snapshot with no history.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12.5pt",
                      "color": "#A5A5A5"
                    }
                  }
                ]
              }
