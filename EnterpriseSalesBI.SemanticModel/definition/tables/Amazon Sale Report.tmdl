	partition 'Amazon Sale Report' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Data\SalesBI\Amazon Sale Report.csv"),[Delimiter=",", Columns=24, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"index", Int64.Type}, {"Order ID", type text}, {"Date", type text}, {"Status", type text}, {"Fulfilment", type text}, {"Sales Channel ", type text}, {"ship-service-level", type text}, {"Style", type text}, {"SKU", type text}, {"Category", type text}, {"Size", type text}, {"ASIN", type text}, {"Courier Status", type text}, {"Qty", Int64.Type}, {"currency", type text}, {"Amount", type number}, {"ship-city", type text}, {"ship-state", type text}, {"ship-postal-code", Int64.Type}, {"ship-country", type text}, {"promotion-ids", type text}, {"B2B", type logical}, {"fulfilled-by", type text}, {"Unnamed: 22", type text}}),
				    #"Uppercased Text" = Table.TransformColumns(#"Changed Type",{{"ship-city", Text.Upper, type text}, {"ship-state", Text.Upper, type text}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Uppercased Text",{{"ship-postal-code", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type1",{{"ship-postal-code", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"ship-postal-code", Text.Clean, type text}}),
				    Custom1 = Table.TransformColumns(
				    #"Cleaned Text",
				    {
				        {
				            "ship-city",
				            each if _ = null or Text.Trim(_) = ""
				                then null
				                else Text.Trim(_),
				            type nullable text
				        },
				        {
				            "ship-state",
				            each if _ = null or Text.Trim(_) = ""
				                then null
				                else Text.Trim(_),
				            type nullable text
				        }
				    }
				),
				    Custom2 = Table.TransformColumns(
				    #"Custom1",
				    {
				        {
				            "ship-country",
				            each if _ = null or Text.Trim(_) = ""
				                then null
				                else Text.Trim(_),
				            type nullable text
				        }
				    }
				),
				    Custom3 = Custom2,
				    #"Removed Columns" = Table.RemoveColumns(Custom3,{"Unnamed: 22", "index"}),
				    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Removed Columns", {{"Date", type date}}, "en-US"),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Changed Type with Locale",{{"Amount", type number}, {"Qty", Int64.Type}}),
				    Custom4 = Table.TransformColumnTypes(
				    #"Changed Type2",
				    {
				        {"Order ID", type text},
				        {"Date", type date},
				        {"Status", type text},
				        {"Fulfilment", type text},
				        {"Sales Channel", type text},
				        {"ship-service-level", type text},
				        {"Style", type text},
				        {"SKU", type text},
				        {"Category", type text},
				        {"Size", type text},
				        {"ASIN", type text},
				        {"Courier Status", type text},
				        {"Qty", Int64.Type},
				        {"currency", type text},
				        {"Amount", type number},
				        {"ship-city", type text},
				        {"ship-state", type text},
				        {"ship-postal-code", type text},
				        {"ship-country", type text},
				        {"promotion-ids", type text},
				        {"B2B", type logical},
				        {"fulfilled-by", type text}
				    },
				    [MissingField = MissingField.Ignore]
				),
				    Custom5 = Custom4,
				    #"Added Custom" = Table.AddColumn(Custom5, "SKU_Key", each if [SKU] = null then null
				else Text.Upper(
				    Text.TrimEnd(
				        Text.Trim(Text.Clean(Text.From([SKU]))),
				        "."
				    )
				)),
				    // All order statuses stay in the table; the sale policy lives in one column and the measures.
				    #"Added Status Group" = Table.AddColumn(#"Added Custom", "Status Group", each
				        if List.Contains({"Shipped", "Shipped - Delivered to Buyer"}, [Status]) then "Recognised Sale"
				        else if [Status] = "Cancelled" then "Cancelled"
				        else if List.Contains({"Shipped - Returned to Seller", "Shipped - Returning to Seller", "Shipped - Rejected by Buyer", "Shipped - Lost in Transit", "Shipped - Damaged"}, [Status]) then "Returned / Failed"
				        else "In Progress", type text),
				    StateMap = {{"RJ", "RAJASTHAN"}, {"RAJSHTHAN", "RAJASTHAN"}, {"RAJSTHAN", "RAJASTHAN"}, {"ORISSA", "ODISHA"}, {"NEW DELHI", "DELHI"}, {"PB", "PUNJAB"}, {"PUNJAB/MOHALI/ZIRAKPUR", "PUNJAB"}, {"AR", "ARUNACHAL PRADESH"}, {"NL", "NAGALAND"}, {"PONDICHERRY", "PUDUCHERRY"}},
				    #"Added State Clean" = Table.AddColumn(#"Added Status Group", "State Clean", each if [#"ship-state"] = null then null else List.Accumulate(StateMap, [#"ship-state"], (s, p) => if s = p{0} then p{1} else s), type nullable text)
				in
				    #"Added State Clean"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

