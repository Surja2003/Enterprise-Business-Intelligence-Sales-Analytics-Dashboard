	partition 'Sale Report' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Data\SalesBI\Sale Report.csv"),[Delimiter=",", Columns=7, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Custom1 = Table.TransformColumnTypes(
				    Table.TransformColumns(
				        #"Promoted Headers",
				        {
				            {"SKU Code", each if _ = null or Text.Trim(_) = "" then null else Text.Trim(_), type nullable text},
				            {"Design No.", each if _ = null or Text.Trim(_) = "" then null else Text.Trim(_), type nullable text},
				            {"Category", each if _ = null or Text.Trim(_) = "" then null else Text.Upper(Text.Trim(_)), type nullable text},
				            {"Size", each if _ = null or Text.Trim(_) = "" then null else Text.Upper(Text.Trim(_)), type nullable text},
				            {"Color", each if _ = null or Text.Trim(_) = "" then null else Text.Proper(Text.Trim(_)), type nullable text}
				        }
				    ),
				    {
				        {"Stock", Int64.Type}
				    }
				),
				    Custom2 = Custom1,
				    #"Removed Columns" = Table.RemoveColumns(Custom2,{"index"}),
				    #"Added Custom" = Table.AddColumn(#"Removed Columns", "SKU_Key", each if [SKU] = null then null
				else Text.Upper(
				    Text.TrimEnd(
				        Text.Trim(Text.Clean(Text.From([SKU]))),
				        "."
				    )
				)),
				    #"Removed Columns1" = Table.RemoveColumns(#"Added Custom",{"SKU_Key"}),
				    #"Added Custom1" = Table.AddColumn(#"Removed Columns1", "SKU_Key", each if [SKU Code] = null then null
				else Text.Upper(
				    Text.TrimEnd(
				        Text.Trim(Text.Clean(Text.From([SKU Code]))),
				        {"."}
				    )
				)),
				    #"Trimmed Text" = Table.TransformColumns(#"Added Custom1",{{"SKU Code", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"SKU Code", Text.Clean, type text}}),
				    #"Trimmed Text1" = Table.TransformColumns(#"Cleaned Text",{{"Design No.", Text.Trim, type text}}),
				    #"Cleaned Text1" = Table.TransformColumns(#"Trimmed Text1",{{"Design No.", Text.Clean, type text}}),
				    #"Trimmed Text2" = Table.TransformColumns(#"Cleaned Text1",{{"SKU_Key", Text.Trim, type text}}),
				    #"Cleaned Text2" = Table.TransformColumns(#"Trimmed Text2",{{"SKU_Key", Text.Clean, type text}}),
				    #"Uppercased Text" = Table.TransformColumns(#"Cleaned Text2",{{"SKU Code", Text.Upper, type text}, {"Design No.", Text.Upper, type text}, {"SKU_Key", Text.Upper, type text}}),
				    #"Filtered Rows" = Table.SelectRows(#"Uppercased Text", each ([SKU Code] <> null)),
				    #"Removed Columns2" = Table.RemoveColumns(#"Filtered Rows",{"SKU_Key"}),
				    #"Added Custom2" = Table.AddColumn(#"Removed Columns2", "SKU_Key", each if [SKU Code] = null or [SKU Code] = "#REF!" then
				    Text.Upper(
				        Text.Combine(
				            {
				                Text.From([#"Design No."]),
				                Text.From([Color]),
				                Text.From([Size])
				            },
				            "-"
				        )
				    )
				else
				    Text.Upper(Text.Trim([SKU Code])))
				in
				    #"Added Custom2"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

