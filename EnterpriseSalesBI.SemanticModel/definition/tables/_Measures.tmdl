			    "<text x='18' y='71' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE(IF(ISBLANK([Amazon Revenue]), "", "Top 10 styles earn " & FORMAT([Top 10 Style Share %], "0%") & " of Amazon sales, led by " & [Top Style Name]), "&", "and") & "</text>" &
			    "<text x='18' y='90' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE(IF(ISBLANK([Amazon Revenue]), "", [Top State Name] & " is the largest Amazon market at " & FORMAT([Top State Share %], "0%") & " of sales"), "&", "and") & "</text>" &
			    "<text x='18' y='109' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE(IF(ISBLANK([Amazon All Orders]), "", FORMAT([Amazon Cancellation Rate %], "0.0%") & " of Amazon orders were cancelled"), "&", "and") & "</text>" &
			    "<text x='18' y='128' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE(IF(ISBLANK([Amazon All Orders]), "", "and " & FORMAT([Amazon Return Rate %], "0.0%") & " came back or failed in delivery"), "&", "and") & "</text>" &
			    "<text x='18' y='147' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE(IF(ISBLANK([International Revenue]), "No International sales in this selection", "Largest International buyer: " & LEFT([International Top Customer], 26)), "&", "and") & "</text>" &
			    "<text x='18' y='166' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE(IF(ISBLANK([International Revenue]), "", "at " & FORMAT([International Top Customer Share %], "0%") & " of that segment"), "&", "and") & "</text>" &
			    "<text x='18' y='195' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#D6AC58'>" & SUBSTITUTE("READ THIS BEFORE COMPARING", "&", "and") & "</text>" &
			    "<text x='18' y='214' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Amazon covers 31 Mar to 29 Jun 2022. International", "&", "and") & "</text>" &
			    "<text x='18' y='233' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("covers 5 Jun 2021 to 11 May 2022. They overlap only", "&", "and") & "</text>" &
			    "<text x='18' y='252' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("in Apr to May 2022, so totals are not like for like.", "&", "and") & "</text>" &
			    "<text x='18' y='281' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE("Net Profit: not available. COGS data is required.", "&", "and") & "</text>" &
			    "<text x='18' y='300' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Expenses are one event sheet, not business costs.", "&", "and") & "</text>" &
			    "<text x='18' y='319' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Stock and MRP are not sales and are excluded here.", "&", "and") & "</text>" &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
