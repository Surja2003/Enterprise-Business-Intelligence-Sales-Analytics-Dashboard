	measure 'Insights Amazon' =
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='403' height='246' viewBox='0 0 403 246'>" &
			    "<rect x='0.5' y='0.5' width='402' height='245' rx='10' fill='#141414' stroke='#262626'/>" &
			    "<text x='18' y='30' font-family='Segoe UI, sans-serif' font-size='14' font-weight='600' fill='#F2F2F2'>Reading this page</text>" &
			    "<text x='18' y='52' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE("Sales count only Shipped and Delivered orders.", "&", "and") & "</text>" &
			    "<text x='18' y='71' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE(IF(ISBLANK([Amazon All Orders]), "No Amazon orders in this selection", "Cancelled value not counted: ₹" & IF(ISBLANK([Amazon Cancelled Value]), "—", IF(ABS([Amazon Cancelled Value]) >= 1000000, FORMAT([Amazon Cancelled Value] / 1000000, "0.0") & "M", IF(ABS([Amazon Cancelled Value]) >= 1000, FORMAT([Amazon Cancelled Value] / 1000, "0.0") & "K", FORMAT([Amazon Cancelled Value], "#,0"))))), "&", "and") & "</text>" &
			    "<text x='18' y='90' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE(IF(ISBLANK([Amazon All Orders]), "", "In progress orders not counted: " & FORMAT(0 + [Amazon In Progress Orders], "#,0")), "&", "and") & "</text>" &
			    "<text x='18' y='109' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE(IF(ISBLANK([Amazon All Orders]), "", "Returned or failed orders: " & FORMAT(0 + [Amazon Returned Orders], "#,0")), "&", "and") & "</text>" &
			    "<text x='18' y='138' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Nearly every order ships to India, so a country", "&", "and") & "</text>" &
			    "<text x='18' y='157' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("chart would add nothing and is left out.", "&", "and") & "</text>" &
			    "<text x='18' y='176' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("The 29 Jun cut-off makes June slightly short.", "&", "and") & "</text>" &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 7d886abd-76a4-47c6-a424-6cb96905dbcd
		dataCategory: ImageUrl

	measure 'Top 10 Color Stock' =
			VAR R = IF(ISINSCOPE('Sale Report'[Color]) && [Total Stock] > 0,
			    ROWNUMBER(FILTER(ALLSELECTED('Sale Report'[Color]), [Total Stock] > 0 && NOT ISBLANK('Sale Report'[Color])), ORDERBY([Total Stock], DESC, 'Sale Report'[Color], ASC)))
			RETURN IF(NOT ISBLANK(R) && R <= 10, [Total Stock])
		formatString: #,0
		displayFolder: 6. Inventory
		lineageTag: 426bf73b-0d79-46f4-9af4-9d8775683f88

	measure 'KPI Intl Customers' =
			VAR _Raw = FORMAT([International Customers], "#,0")
			VAR _Value = IF(_Raw = "" || _Raw = "₹" || _Raw = "₹—", "—", _Raw)
			VAR _Sub = IF(ISBLANK([International Revenue]), "No data in selection", "Distinct billed names")
			VAR _SubColor = "#8A8A8A"
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='195' height='128' viewBox='0 0 195 128'>" &
			    "<rect x='0.5' y='0.5' width='194' height='127' rx='10' fill='#141414' stroke='#262626'/>" &
			    "<rect x='14' y='0' width='26' height='2' fill='#58A6A6'/>" &
			    "<text x='14' y='24' font-family='Segoe UI, sans-serif' font-size='11' fill='#A5A5A5'>Customers</text>" &
			    "<text x='14' y='56' font-family='Segoe UI, sans-serif' font-size='27' font-weight='600' fill='#F2F2F2'>" & _Value & "</text>" &
			    "<text x='14' y='74' font-family='Segoe UI, sans-serif' font-size='10.5' fill='" & _SubColor & "'>" & SUBSTITUTE(_Sub, "&", "and") & "</text>" &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: e7e639eb-1859-400b-bd39-1830b86763d4
		dataCategory: ImageUrl

	measure 'KPI Amazon Units Plain' =
			VAR _Raw = IF(ISBLANK([Amazon Units Sold]), "—", IF(ABS([Amazon Units Sold]) >= 1000000, FORMAT([Amazon Units Sold] / 1000000, "0.0") & "M", IF(ABS([Amazon Units Sold]) >= 1000, FORMAT([Amazon Units Sold] / 1000, "0.0") & "K", FORMAT([Amazon Units Sold], "#,0"))))
			VAR _Value = IF(_Raw = "" || _Raw = "₹" || _Raw = "₹—", "—", _Raw)
			VAR _Sub = IF(ISBLANK([Amazon All Orders]), "No data in selection", "Recognised orders only")
			VAR _SubColor = "#8A8A8A"
			VAR _Base = FILTER(VALUES(DimDate[Date]), NOT ISBLANK([Amazon Units Sold]))
			VAR _Vals = ADDCOLUMNS(_Base, "@v", [Amazon Units Sold], "@i", RANKX(_Base, DimDate[Date], , ASC))
			VAR _N = COUNTROWS(_Vals)
			VAR _Min = MINX(_Vals, [@v])
			VAR _Max = MAXX(_Vals, [@v])
			VAR _Pts = CONCATENATEX(
			    _Vals,
			    FORMAT(14 + DIVIDE([@i] - 1, MAX(_N - 1, 1)) * 237, "0.0") & "," & FORMAT(116 - DIVIDE([@v] - _Min, MAX(_Max - _Min, 1)) * 30, "0.0"),
			    " ", [@i], ASC
			)
			VAR _Spark = IF(_N >= 2,
			    "<polygon points='14,116 " & _Pts & " 251,116' fill='#D6AC58' fill-opacity='0.12'/>" &
			    "<polyline points='" & _Pts & "' fill='none' stroke='#D6AC58' stroke-width='1.6' stroke-linejoin='round'/>")
			
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='265' height='128' viewBox='0 0 265 128'>" &
			    "<rect x='0.5' y='0.5' width='264' height='127' rx='10' fill='#141414' stroke='#262626'/>" &
			    "<rect x='14' y='0' width='26' height='2' fill='#D6AC58'/>" &
			    "<text x='14' y='24' font-family='Segoe UI, sans-serif' font-size='11' fill='#A5A5A5'>Amazon Units Sold</text>" &
			    "<text x='14' y='56' font-family='Segoe UI, sans-serif' font-size='27' font-weight='600' fill='#F2F2F2'>" & _Value & "</text>" &
			    "<text x='14' y='74' font-family='Segoe UI, sans-serif' font-size='10.5' fill='" & _SubColor & "'>" & SUBSTITUTE(_Sub, "&", "and") & "</text>" & _Spark &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: b413aa66-5787-4e00-8339-6e7cf61dd402
		dataCategory: ImageUrl

