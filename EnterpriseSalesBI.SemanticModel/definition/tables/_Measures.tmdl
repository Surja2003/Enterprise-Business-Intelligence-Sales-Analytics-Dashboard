	measure 'Top 15 Marketplace Gap' =
			VAR R = IF(ISINSCOPE('May-2022'[Sku]) && [Marketplace Product Gap] > 0,
			    ROWNUMBER(FILTER(ALLSELECTED('May-2022'[Sku]), [Marketplace Product Gap] > 0), ORDERBY([Marketplace Product Gap], DESC, 'May-2022'[Sku], ASC)))
			RETURN IF(NOT ISBLANK(R) && R <= 15, [Marketplace Product Gap])
		formatString: \₹#,0
		displayFolder: 7. Pricing
		lineageTag: cfa7ba03-d1a1-434c-9c7d-ad5c76f9af7b

