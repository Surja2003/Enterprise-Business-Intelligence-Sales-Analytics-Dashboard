	measure 'Marketplace Product Gap' = IF(HASONEVALUE('May-2022'[Sku]), MAXX('May-2022', VAR P = SWITCH(SELECTEDVALUE(Marketplace[Marketplace]), "Amazon", 'May-2022'[Amazon MRP], "Amazon FBA", 'May-2022'[Amazon FBA MRP], "Flipkart", 'May-2022'[Flipkart MRP], "Myntra", 'May-2022'[Myntra MRP], "Ajio", 'May-2022'[Ajio MRP], "Snapdeal", 'May-2022'[Snapdeal MRP], "Paytm", 'May-2022'[Paytm MRP], "Limeroad", 'May-2022'[Limeroad MRP]) VAR Prices = {'May-2022'[Amazon MRP], 'May-2022'[Amazon FBA MRP], 'May-2022'[Flipkart MRP], 'May-2022'[Myntra MRP], 'May-2022'[Ajio MRP], 'May-2022'[Snapdeal MRP], 'May-2022'[Paytm MRP], 'May-2022'[Limeroad MRP]} VAR Valid = FILTER(Prices, NOT ISBLANK([Value])) VAR Hi = MAXX(Valid, [Value]) VAR Lo = MINX(Valid, [Value]) RETURN IF(NOT ISBLANK(P), P - Lo)))
