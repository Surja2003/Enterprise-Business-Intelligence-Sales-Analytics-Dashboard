		dataCategory: ImageUrl

	measure 'Stock Category Rank' =
			IF(
			    ISINSCOPE('Sale Report'[Category]) && [Total Stock] > 0,
			    ROWNUMBER(FILTER(ALLSELECTED('Sale Report'[Category]), [Total Stock] > 0 && NOT ISBLANK('Sale Report'[Category])), ORDERBY([Total Stock], DESC, 'Sale Report'[Category], ASC))
			)
		formatString: 0
		displayFolder: 6. Inventory
		lineageTag: bc4d6686-4660-4e34-bfb5-282bc3aea7de

	measure 'Top 8 Category Stock' = VAR R = [Stock Category Rank] RETURN IF(NOT ISBLANK(R) && R <= 8, [Total Stock])
		formatString: #,0
		displayFolder: 6. Inventory
		lineageTag: 3f163b8b-307a-4ff6-9b9f-e499e2611bb6

	measure 'Top 8 Category Units' = VAR R = [Stock Category Rank] RETURN IF(NOT ISBLANK(R) && R <= 8, [Units Sold on Matched SKUs])
		formatString: #,0
		displayFolder: 6. Inventory
		lineageTag: 2aa1b73b-8d9f-4be1-afee-76ceaef9d487

	measure 'Period Amazon' = VAR _D1 = CALCULATE(MIN('Amazon Sale Report'[Date])) VAR _D2 = CALCULATE(MAX('Amazon Sale Report'[Date])) RETURN IF(ISBLANK(_D1), "No data in selection", "Amazon  ·  " & FORMAT(_D1, "d MMM yyyy") & " to " & FORMAT(_D2, "d MMM yyyy"))
		displayFolder: 3. Combined
		lineageTag: 9732552b-2610-46a0-87a7-df6e755eaf76

	measure 'Period International' = VAR _D1 = CALCULATE(MIN('International sale Report'[DATE])) VAR _D2 = CALCULATE(MAX('International sale Report'[DATE])) RETURN IF(ISBLANK(_D1), "No data in selection", "International  ·  " & FORMAT(_D1, "d MMM yyyy") & " to " & FORMAT(_D2, "d MMM yyyy"))
		displayFolder: 3. Combined
		lineageTag: 94c6861e-5f6e-48ff-926b-f4a772b4fe26

	measure 'Amazon Order Value' = SUM('Amazon Sale Report'[Amount])
		formatString: \₹#,0
		displayFolder: 1. Amazon
		lineageTag: 08d4ae96-7c62-4bb4-b63f-0c5171162bc6

	measure 'Marketplace Min MRP' =
			SWITCH(
			    SELECTEDVALUE(Marketplace[Marketplace]),
			    "Amazon", MIN('May-2022'[Amazon MRP]),
			    "Amazon FBA", MIN('May-2022'[Amazon FBA MRP]),
			    "Flipkart", MIN('May-2022'[Flipkart MRP]),
			    "Myntra", MIN('May-2022'[Myntra MRP]),
			    "Ajio", MIN('May-2022'[Ajio MRP]),
			    "Snapdeal", MIN('May-2022'[Snapdeal MRP]),
			    "Paytm", MIN('May-2022'[Paytm MRP]),
			    "Limeroad", MIN('May-2022'[Limeroad MRP])
			)
		formatString: \₹#,0
		displayFolder: 7. Pricing
		lineageTag: c66bb3d5-ff48-4f3a-8064-09f2c8ab118d

	measure 'Marketplace Max MRP' =
			SWITCH(
			    SELECTEDVALUE(Marketplace[Marketplace]),
			    "Amazon", MAX('May-2022'[Amazon MRP]),
			    "Amazon FBA", MAX('May-2022'[Amazon FBA MRP]),
			    "Flipkart", MAX('May-2022'[Flipkart MRP]),
			    "Myntra", MAX('May-2022'[Myntra MRP]),
			    "Ajio", MAX('May-2022'[Ajio MRP]),
			    "Snapdeal", MAX('May-2022'[Snapdeal MRP]),
			    "Paytm", MAX('May-2022'[Paytm MRP]),
			    "Limeroad", MAX('May-2022'[Limeroad MRP])
			)
		formatString: \₹#,0
		displayFolder: 7. Pricing
		lineageTag: 92f790ee-698b-4320-a282-44a0b3dc9835

	measure 'Selected SKU' = IF(HASONEVALUE(DimSKU[SKU_Key]), VALUES(DimSKU[SKU_Key]), "All SKUs. Right-click a SKU to drill through")
		displayFolder: 6. Inventory
		lineageTag: 7026e490-d969-489a-b485-8d184843ab3f

	measure 'SKU Amazon Sales Share %' = DIVIDE([Amazon Revenue], CALCULATE([Amazon Revenue], REMOVEFILTERS(DimSKU)))
		formatString: 0.00%
		displayFolder: 6. Inventory
		lineageTag: 157e67f9-6b1c-418a-a6dc-c5a7fe5815e6

	measure 'SKU Category' = VAR _V = MAX('Amazon Sale Report'[Category]) RETURN IF(LEN(_V) > 0, _V, VAR _V = MAX('Sale Report'[Category]) RETURN IF(LEN(_V) > 0, _V, ""))
		displayFolder: 6. Inventory
		lineageTag: fb6caa1e-0fc9-483f-8e04-2819af28a51e

	measure 'SKU Style' = VAR _V = MAX('Amazon Sale Report'[Style]) RETURN IF(LEN(_V) > 0, _V, VAR _V = MAX('International sale Report'[Style]) RETURN IF(LEN(_V) > 0, _V, ""))
		displayFolder: 6. Inventory
		lineageTag: 336c8285-e249-4889-b38d-5a6df047bd6a

	measure 'SKU Size' = VAR _V = MAX('Amazon Sale Report'[Size]) RETURN IF(LEN(_V) > 0, _V, VAR _V = MAX('Sale Report'[Size]) RETURN IF(LEN(_V) > 0, _V, VAR _V = MAX('International sale Report'[Final Size]) RETURN IF(LEN(_V) > 0, _V, "")))
		displayFolder: 6. Inventory
		lineageTag: ccbb9884-26eb-4ee0-8f96-96a2dcbe7256

	measure 'SKU Colour' = VAR _V = MAX('Sale Report'[Color]) RETURN IF(LEN(_V) > 0, _V, "")
		displayFolder: 6. Inventory
		lineageTag: 528573f2-bd58-43bf-9819-bf800fc44eb8

	measure 'SKU Attributes' =
			IF(HASONEVALUE(DimSKU[SKU_Key]),
			    "SKU DETAIL" &
			    IF(LEN([SKU Category]) > 0, "  ·  " & UPPER([SKU Category])) &
			    IF(LEN([SKU Style]) > 0, "  ·  STYLE " & [SKU Style]) &
			    IF(LEN([SKU Size]) > 0, "  ·  SIZE " & [SKU Size]) &
			    IF(LEN([SKU Colour]) > 0, "  ·  " & UPPER([SKU Colour])),
			    "SKU DETAIL")
		displayFolder: 6. Inventory
