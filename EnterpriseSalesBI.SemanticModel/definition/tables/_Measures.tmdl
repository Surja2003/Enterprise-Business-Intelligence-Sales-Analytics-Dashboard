			    "<text x='18' y='119' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE("Remaining stock and turnover cannot be", "&", "and") & "</text>" &
			    "<text x='18' y='138' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE("calculated without inventory history.", "&", "and") & "</text>" &
