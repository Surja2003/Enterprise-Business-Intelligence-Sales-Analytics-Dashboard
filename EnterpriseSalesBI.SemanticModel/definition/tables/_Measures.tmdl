	measure 'Insights Pricing' =
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='403' height='406' viewBox='0 0 403 406'>" &
			    "<rect x='0.5' y='0.5' width='402' height='405' rx='10' fill='#141414' stroke='#262626'/>" &
