			    "<text x='18' y='52' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE(FORMAT([Products With Price Variation], "#,0") & " products have different MRPs across", "&", "and") & "</text>" &
			    "<text x='18' y='71' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE("marketplaces, with an average gap of ₹" & FORMAT([Avg Price Spread], "#,0"), "&", "and") & "</text>" &
			    "<text x='18' y='90' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE("and a maximum of ₹" & FORMAT([Max Price Spread], "#,0"), "&", "and") & "</text>" &
			    "<text x='18' y='119' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#D6AC58'>" & SUBSTITUTE("NO PRICE MOVEMENT BETWEEN SNAPSHOTS", "&", "and") & "</text>" &
			    "<text x='18' y='138' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Mar 2021 and May 2022 hold identical MRPs for", "&", "and") & "</text>" &
			    "<text x='18' y='157' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("every product. Amazon MRP changes: " & FORMAT([Snapshot Price Changes], "0"), "&", "and") & "</text>" &
			    "<text x='18' y='176' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("The two files may be one price list.", "&", "and") & "</text>" &
			    "<text x='18' y='205' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE("MRP is a list price, never revenue.", "&", "and") & "</text>" &
