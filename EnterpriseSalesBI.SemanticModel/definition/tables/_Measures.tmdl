	measure 'Insights Expense' =
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='816' height='396' viewBox='0 0 816 396'>" &
			    "<rect x='0.5' y='0.5' width='815' height='395' rx='10' fill='#141414' stroke='#262626'/>" &
			    "<text x='18' y='30' font-family='Segoe UI, sans-serif' font-size='14' font-weight='600' fill='#F2F2F2'>Reading this page</text>" &
			    "<text x='18' y='52' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E6E6E6'>" & SUBSTITUTE("This sheet appears to record one event (IIGF, June 2022): travel, hotel, labour and sundries.", "&", "and") & "</text>" &
			    "<text x='18' y='71' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#E77D67'>" & SUBSTITUTE("It is not the cost base of the sales business, so it must not be netted against sales.", "&", "and") & "</text>" &
			    "<text x='18' y='100' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("The difference of ₹" & FORMAT([Recorded Net Cash Position], "#,0") & " matches the Pending Amount row on the sheet.", "&", "and") & "</text>" &
			    "<text x='18' y='119' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("It means spending exceeded receipts on this sheet. It is not a profit or loss.", "&", "and") & "</text>" &
			    "<text x='18' y='148' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("Expense lines have no dates, so no expense timeline is possible.", "&", "and") & "</text>" &
			    "<text x='18' y='167' font-family='Segoe UI, sans-serif' font-size='12.5' fill='#9A9A9A'>" & SUBSTITUTE("The date on each row belongs to the receipt beside it, not to the expense.", "&", "and") & "</text>" &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: 250e08d4-c891-4d90-b926-e4dc24c53783
