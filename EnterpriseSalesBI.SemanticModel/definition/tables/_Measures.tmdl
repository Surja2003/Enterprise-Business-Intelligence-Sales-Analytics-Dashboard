	measure 'Total Recorded Sales' =
			VAR A = IF("Amazon" IN VALUES(Segment[Segment]), [Amazon Revenue])
			VAR I = IF("International" IN VALUES(Segment[Segment]), [International Revenue])
			RETURN A + I
		formatString: \₹#,0
		displayFolder: 3. Combined
		lineageTag: 643ea736-e598-4034-b76a-283f99e22931

	measure 'Total Recorded Units' =
			VAR A = IF("Amazon" IN VALUES(Segment[Segment]), [Amazon Units Sold])
			VAR I = IF("International" IN VALUES(Segment[Segment]), [International Units])
			RETURN A + I
		formatString: #,0
		displayFolder: 3. Combined
		lineageTag: 5057f18e-ab95-4696-a16f-d2df8063b03f

	measure 'Segment Sales' =
			SWITCH(
			    SELECTEDVALUE(Segment[Segment]),
			    "Amazon", [Amazon Revenue],
			    "International", [International Revenue],
			    [Total Recorded Sales]
			)
		formatString: \₹#,0
		displayFolder: 3. Combined
		lineageTag: 603714a6-6058-4778-9d52-7e638a60578d

	measure 'Amazon Sales Share %' = DIVIDE([Amazon Revenue], [Amazon Revenue] + [International Revenue])
