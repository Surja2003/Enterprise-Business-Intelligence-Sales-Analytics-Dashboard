	measure 'Net Profit Status' = "Not Available - COGS Data Required"
		displayFolder: 3. Combined
		lineageTag: a77699e7-b10c-446a-92ba-90fef0bc3c5f

	measure 'Period Label' =
			VAR A1 = CALCULATE(MIN('Amazon Sale Report'[Date]))
			VAR I1 = CALCULATE(MIN('International sale Report'[DATE]))
			VAR A2 = CALCULATE(MAX('Amazon Sale Report'[Date]))
			VAR I2 = CALCULATE(MAX('International sale Report'[DATE]))
			VAR Seg = IF(HASONEVALUE(Segment[Segment]), VALUES(Segment[Segment]), "Amazon + International")
			VAR D1 = SWITCH(Seg, "Amazon", A1, "International", I1, IF(ISBLANK(A1), I1, IF(ISBLANK(I1), A1, MIN(A1, I1))))
			VAR D2 = SWITCH(Seg, "Amazon", A2, "International", I2, IF(ISBLANK(A2), I2, IF(ISBLANK(I2), A2, MAX(A2, I2))))
			RETURN IF(ISBLANK(D1), "No data in selection", Seg & "  ·  " & FORMAT(D1, "d MMM yyyy") & " to " & FORMAT(D2, "d MMM yyyy"))
		displayFolder: 3. Combined
		lineageTag: 7465e2e6-528b-404a-899f-bf3193b7ae47

