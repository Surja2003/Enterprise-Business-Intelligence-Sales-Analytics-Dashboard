	measure 'Insights Logistics' =
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='636' height='340' viewBox='0 0 636 340'>" &
			    "<rect x='0.5' y='0.5' width='635' height='339' rx='10' fill='#141414' stroke='#262626'/>" &
