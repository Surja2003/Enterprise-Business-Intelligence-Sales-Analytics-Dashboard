	measure 'KPI Total Sales' =
			VAR _Raw = "₹" & IF(ISBLANK([Total Recorded Sales]), "—", IF(ABS([Total Recorded Sales]) >= 1000000, FORMAT([Total Recorded Sales] / 1000000, "0.0") & "M", IF(ABS([Total Recorded Sales]) >= 1000, FORMAT([Total Recorded Sales] / 1000, "0.0") & "K", FORMAT([Total Recorded Sales], "#,0"))))
			VAR _Value = IF(_Raw = "" || _Raw = "₹" || _Raw = "₹—", "—", _Raw)
			VAR _Sub = "Periods differ by segment"
			VAR _SubColor = "#8A8A8A"
			VAR _Base = FILTER(VALUES(DimDate[Year Month Sort]), NOT ISBLANK([Total Recorded Sales]))
			VAR _Vals = ADDCOLUMNS(_Base, "@v", [Total Recorded Sales], "@i", RANKX(_Base, DimDate[Year Month Sort], , ASC))
			VAR _N = COUNTROWS(_Vals)
			VAR _Min = MINX(_Vals, [@v])
			VAR _Max = MAXX(_Vals, [@v])
			VAR _Pts = CONCATENATEX(
			    _Vals,
			    FORMAT(14 + DIVIDE([@i] - 1, MAX(_N - 1, 1)) * 167, "0.0") & "," & FORMAT(116 - DIVIDE([@v] - _Min, MAX(_Max - _Min, 1)) * 30, "0.0"),
			    " ", [@i], ASC
			)
			VAR _Spark = IF(_N >= 2,
			    "<polygon points='14,116 " & _Pts & " 181,116' fill='#D6AC58' fill-opacity='0.12'/>" &
			    "<polyline points='" & _Pts & "' fill='none' stroke='#D6AC58' stroke-width='1.6' stroke-linejoin='round'/>")
			
			VAR _Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='195' height='128' viewBox='0 0 195 128'>" &
			    "<rect x='0.5' y='0.5' width='194' height='127' rx='10' fill='#141414' stroke='#262626'/>" &
			    "<rect x='14' y='0' width='26' height='2' fill='#D6AC58'/>" &
			    "<text x='14' y='24' font-family='Segoe UI, sans-serif' font-size='11' fill='#A5A5A5'>Total Recorded Sales</text>" &
			    "<text x='14' y='56' font-family='Segoe UI, sans-serif' font-size='27' font-weight='600' fill='#F2F2F2'>" & _Value & "</text>" &
			    "<text x='14' y='74' font-family='Segoe UI, sans-serif' font-size='10.5' fill='" & _SubColor & "'>" & SUBSTITUTE(_Sub, "&", "and") & "</text>" & _Spark &
			    "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg, "%", "%25"), "#", "%23")
		displayFolder: SVG
		lineageTag: bb800300-daae-46b9-a8e9-83192a75af7c
		dataCategory: ImageUrl

