	measure 'Amazon Revenue Previous Month' = CALCULATE([Amazon Revenue], DATEADD(DimDate[Date], -1, MONTH))
		formatString: \₹#,0
		displayFolder: 1. Amazon
		lineageTag: 6f97545f-32ba-4cfd-8943-145a39cdc37b

	measure 'Amazon Trading Days' = CALCULATE(DISTINCTCOUNT('Amazon Sale Report'[Date]), 'Amazon Sale Report'[Status Group] = "Recognised Sale")
		formatString: #,0
		displayFolder: 1. Amazon
		lineageTag: a74ea5a4-0872-4a3d-a468-139c7a35737d

	measure 'Amazon Revenue MoM %' =
			VAR PrevDays = CALCULATE([Amazon Trading Days], DATEADD(DimDate[Date], -1, MONTH))
			RETURN
			    IF(
			        HASONEVALUE(DimDate[Year Month Sort]) && PrevDays >= 20 && NOT ISBLANK([Amazon Revenue]),
			        DIVIDE([Amazon Revenue] - [Amazon Revenue Previous Month], [Amazon Revenue Previous Month])
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Amazon
		lineageTag: 47955bf1-bbcc-4e67-b9ff-3c7c24f7713e

	measure 'Amazon Latest Month MoM %' =
			VAR LatestDay = CALCULATE(MAX('Amazon Sale Report'[Date]), 'Amazon Sale Report'[Status Group] = "Recognised Sale")
			VAR CurrentSales = CALCULATE([Amazon Revenue], DATESBETWEEN(DimDate[Date], EOMONTH(LatestDay, -1) + 1, EOMONTH(LatestDay, 0)))
			VAR PriorSales = CALCULATE([Amazon Revenue], DATESBETWEEN(DimDate[Date], EOMONTH(LatestDay, -2) + 1, EOMONTH(LatestDay, -1)))
			VAR PriorDays = CALCULATE([Amazon Trading Days], DATESBETWEEN(DimDate[Date], EOMONTH(LatestDay, -2) + 1, EOMONTH(LatestDay, -1)))
			RETURN IF(PriorDays >= 20, DIVIDE(CurrentSales - PriorSales, PriorSales))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Amazon
		lineageTag: 87ddb44a-7c23-43a1-9828-0303cca0c40e

	measure 'Amazon Latest Month Label' =
			VAR LatestDay = CALCULATE(MAX('Amazon Sale Report'[Date]), 'Amazon Sale Report'[Status Group] = "Recognised Sale")
			RETURN FORMAT(LatestDay, "MMM yy") & " vs " & FORMAT(EOMONTH(LatestDay, -1), "MMM yy")
		displayFolder: 1. Amazon
		lineageTag: a2846193-54ed-4ddb-83d2-37a9b5b62cf7

	measure 'Amazon Previous Year Sales' = CALCULATE([Amazon Revenue], DATEADD(DimDate[Date], -1, YEAR))
